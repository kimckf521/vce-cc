generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Topic {
  id          String     @id @default(cuid())
  name        String
  createdAt   DateTime   @default(now())
  description String?
  order       Int        @default(0)
  slug        String
  // Nullable during Phase 1 migration; backfilled to mathematical-methods via
  // scripts/seed-and-backfill-multi-subject.ts, then optionally made required
  // in Stage 2 (another db:push).
  subjectId   String?
  subject     Subject?   @relation(fields: [subjectId], references: [id])
  questions   Question[]
  subtopics   Subtopic[]
  questionSetItems QuestionSetItem[]

  @@unique([subjectId, slug])
  @@unique([subjectId, name])
  @@index([subjectId])
}

model Subtopic {
  id        String     @id @default(cuid())
  name      String
  slug      String
  order     Int        @default(0)
  topicId   String
  topic     Topic      @relation(fields: [topicId], references: [id], onDelete: Cascade)
  questions Question[] @relation("QuestionToSubtopic")
  questionSetItems QuestionSetItem[] @relation("QuestionSetItemToSubtopic")

  @@unique([topicId, slug])
}

model Exam {
  id          String           @id @default(cuid())
  year        Int
  examType    ExamType
  createdAt   DateTime         @default(now())
  answerUrl   String?
  pdfUrl      String?
  // Nullable during Phase 1 migration; backfilled to mathematical-methods.
  subjectId   String?
  subject     Subject?         @relation(fields: [subjectId], references: [id])
  questions   Question[]
  completions ExamCompletion[]

  @@unique([subjectId, year, examType])
  @@index([subjectId])
}

model Question {
  id             String     @id @default(cuid())
  examId         String
  marks          Int
  createdAt      DateTime   @default(now())
  content        String
  difficulty     Difficulty @default(MEDIUM)
  imageUrl       String?
  part           String?
  questionNumber Int
  topicId        String
  // Denormalized for cheap subject-scoped queries (search, dashboards).
  // Authoritatively derived from topicId/examId but stored for indexing.
  // Nullable during Phase 1 migration.
  subjectId      String?
  updatedAt      DateTime   @updatedAt
  attempts       Attempt[]
  exam           Exam       @relation(fields: [examId], references: [id], onDelete: Cascade)
  topic          Topic      @relation(fields: [topicId], references: [id])
  subject        Subject?   @relation(fields: [subjectId], references: [id])
  solution       Solution?
  subtopics      Subtopic[] @relation("QuestionToSubtopic")
  assessmentItems AssessmentItem[]

  @@index([topicId, difficulty])
  @@index([examId, questionNumber])
  @@index([topicId, examId])
  @@index([subjectId])
}

model Solution {
  id         String   @id @default(cuid())
  questionId String   @unique
  content    String
  imageUrl   String?
  videoUrl   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model User {
  id                   String               @id
  email                String               @unique
  name                 String?
  createdAt            DateTime             @default(now())
  role                 Role                 @default(STUDENT)
  stripeCustomerId     String?              @unique
  referredByCode       String?              // Referral code used at signup (immutable record)
  activeSessionId      String?              // Single-active-session enforcement — new logins rotate this, stale sessions get kicked
  // Maths subjects the student has registered as "studying", as URL slugs
  // (e.g. ["methods","specialist"]). A display preference only — NOT access
  // or billing (that lives on SubjectEnrolment). Empty = treat as "all
  // subjects" so legacy/un-onboarded users see the full switcher. Filters the
  // personal subject switcher (SubjectSidebar / MobileDrawer).
  studyingSubjects     String[]             @default([])
  attempts             Attempt[]
  questionSetAttempts  QuestionSetAttempt[]
  examSessions         ExamSession[]
  extractionSessions   ExtractionSession[]
  examCompletions      ExamCompletion[]
  enrolments           SubjectEnrolment[]
  affiliate            Affiliate?
  referral             Referral?            @relation("ReferredUser")
  /// Inverse side of AdminActionLog.actor. Lets us list a user's admin
  /// actions for accountability; SetNull on user delete preserves history.
  adminActions         AdminActionLog[]     @relation("AdminAuditActor")
  assessments          Assessment[]         @relation("TeacherAssessments")

  @@index([referredByCode])
}

model ExamCompletion {
  id        String   @id @default(cuid())
  userId    String
  examId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam      Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@unique([userId, examId])
  @@index([userId])
}

model Subject {
  id           String             @id @default(cuid())
  // `name` and `slug` keep field-level @unique for backward compat with
  // existing findUnique({where:{slug}}) callsites. The composite uniques
  // below scope uniqueness per curriculum — when HSC/QCE/WACE content
  // lands and we need same-named subjects across curricula, drop the
  // field-level @unique on the two and migrate callers to the composite key.
  name         String             @unique
  slug         String             @unique
  order        Int                @default(0)
  createdAt    DateTime           @default(now())
  // Nullable during Phase 1 migration; backfilled to VCE.
  // Future curricula (HSC, QCE, WACE, ...) are just additional Curriculum rows.
  curriculumId String?
  curriculum   Curriculum?        @relation(fields: [curriculumId], references: [id])
  enrolments   SubjectEnrolment[]
  topics       Topic[]
  exams        Exam[]
  questions    Question[]
  questionSets QuestionSet[]
  assessments  Assessment[]

  @@unique([curriculumId, name])
  @@unique([curriculumId, slug])
  @@index([curriculumId])
}

/// A national/state curriculum framework. VCE for now; HSC, QCE, WACE, SACE,
/// TCE, NTCET, ACT, and AC (national) when their content lands. Adding a new
/// curriculum is `INSERT INTO curriculum` + seeding subjects — no schema work.
model Curriculum {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  shortName String?
  order     Int       @default(0)
  createdAt DateTime  @default(now())
  subjects  Subject[]
}

model SubjectEnrolment {
  id                    String              @id @default(cuid())
  userId                String
  subjectId             String
  tier                  EnrolmentTier       @default(FREE)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @default(now()) @updatedAt
  stripeSubscriptionId  String?
  stripePriceId         String?
  subscriptionStatus    SubscriptionStatus?
  currentPeriodEnd      DateTime?
  cancelAtPeriodEnd     Boolean             @default(false)
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject               Subject             @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([userId, subjectId])
  @@index([userId])
  @@index([subjectId])
  @@index([stripeSubscriptionId])
}

model ExtractionSession {
  id        String   @id @default(cuid())
  userId    String
  pdfName   String
  result    Json
  statuses  Json
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model ExamSession {
  id             String   @id @default(cuid())
  userId         String
  mode           String
  totalQuestions  Int
  correctCount   Int
  incorrectCount Int
  score          Float
  elapsedSeconds Int?
  graded         Boolean  @default(true)
  completedAt    DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions      ExamSessionQuestion[]

  @@index([userId])
  @@index([userId, completedAt])
}

/// Records the exact list of generated-set questions that were practiced
/// in a given ExamSession, plus the user's selection (for MCQ).
model ExamSessionQuestion {
  id                String          @id @default(cuid())
  examSessionId     String
  questionSetItemId String
  /// Display order of this question within the session (0-based).
  order             Int
  /// When multiple source items are bundled into one visible compound
  /// question (e.g. Exam 1 compounds 14–16 items into 8–9 questions),
  /// this records the index of the parent compound group. Items with
  /// the same groupIndex render as sub-parts of the same card.
  groupIndex        Int?
  /// "A" / "B" — Section label for exam2ab. Null for single-mode sessions.
  section           String?
  /// User's MCQ selection (A–D). Null for non-MCQ or unanswered.
  selectedOption    String?
  /// Whether this answer was correct (only set for graded MCQ items).
  correct           Boolean?
  /// Manually-entered marks earned for this question (user self-marks
  /// their open-ended exam answers). Null means not yet marked.
  marksEarned       Int?
  /// Per-sub-part marks for multi-part questions. Shape:
  ///   { "a": 2, "b": 1, "c": null, ... }
  /// When set, `marksEarned` is the sum of the defined sub-part values.
  subPartMarks      Json?
  examSession       ExamSession     @relation(fields: [examSessionId], references: [id], onDelete: Cascade)
  questionSetItem   QuestionSetItem @relation(fields: [questionSetItemId], references: [id], onDelete: Cascade)

  @@index([examSessionId])
  @@index([questionSetItemId])
}

model Attempt {
  id          String        @id @default(cuid())
  userId      String
  questionId  String
  status      AttemptStatus @default(ATTEMPTED)
  bookmarked  Boolean       @default(false)
  marksEarned Int?
  createdAt   DateTime      @default(now())
  question    Question      @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId])
  @@index([questionId])
}

/// Public contact-form submissions from the marketing site.
model ContactMessage {
  id        String              @id @default(cuid())
  name      String
  email     String
  message   String
  status    ContactMessageStatus @default(NEW)
  createdAt DateTime            @default(now())

  @@index([status, createdAt])
  @@index([createdAt])
}

enum ContactMessageStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

enum ExamType {
  EXAM_1
  EXAM_2
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum Role {
  STUDENT
  // Classroom teachers — unlocks the /teacher assessment-builder area.
  // Distinct from TUTOR, which is an affiliate-track marker only.
  TEACHER
  TUTOR
  INFLUENCER
  ADMIN
  SUPER_ADMIN
}

enum AttemptStatus {
  ATTEMPTED
  CORRECT
  INCORRECT
  NEEDS_REVIEW
}

enum EnrolmentTier {
  FREE
  PAID
}

model QuestionSet {
  id          String            @id @default(cuid())
  name        String
  description String?
  isDefault   Boolean           @default(false) // Exactly one row should be true at any time
  /// Archived sets are visually greyed out in the admin UI and treated as
  /// historical record only. They still exist in the DB (rollback safety) but
  /// should not be promoted to default or read from by any page.
  archived    Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  // Nullable during Phase 1 migration; backfilled to mathematical-methods.
  // Future: one default QuestionSet per subject (`isDefault` within subject scope).
  subjectId   String?
  subject     Subject?          @relation(fields: [subjectId], references: [id])
  items       QuestionSetItem[]

  @@index([isDefault])
  @@index([subjectId])
  @@index([archived])
}

model QuestionSetItem {
  id            String              @id @default(cuid())
  questionSetId String
  topicId       String
  type          QuestionSetItemType
  status        QuestionSetItemStatus @default(PENDING)
  order         Int                 @default(0)
  marks         Int
  // Shared scenario paragraph for multi-part items; null for MCQ / SHORT_ANSWER
  preamble      String?
  // Array of { label, marks, content, solution, subParts?: [{ label, marks, content, solution }] }
  // Null for single-part items (MCQ, SHORT_ANSWER)
  parts         Json?
  content       String
  // MCQ-only fields (4 options A–D)
  optionA       String?
  optionB       String?
  optionC       String?
  optionD       String?
  correctOption String? // "A" | "B" | "C" | "D"
  // Solution
  solutionContent String?
  difficulty    Difficulty          @default(MEDIUM)
  tech          Tech?               // Null until classified; the practice assembler filters Exam 1 to TECH_FREE
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  questionSet   QuestionSet         @relation(fields: [questionSetId], references: [id], onDelete: Cascade)
  topic         Topic               @relation(fields: [topicId], references: [id])
  subtopics     Subtopic[]          @relation("QuestionSetItemToSubtopic")
  attempts      QuestionSetAttempt[]
  examSessionQuestions ExamSessionQuestion[]
  assessmentItems AssessmentItem[]

  @@index([questionSetId])
  @@index([topicId])
  @@index([status])
  @@index([tech])
}

model QuestionSetAttempt {
  id                String              @id @default(cuid())
  userId            String
  questionSetItemId String
  status            AttemptStatus       @default(ATTEMPTED)
  bookmarked        Boolean             @default(false)
  createdAt         DateTime            @default(now())
  questionSetItem   QuestionSetItem     @relation(fields: [questionSetItemId], references: [id], onDelete: Cascade)
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionSetItemId])
  @@index([userId])
  @@index([questionSetItemId])
}

enum QuestionSetItemType {
  MCQ
  SHORT_ANSWER
  EXTENDED_ANSWER
  EXTENDED_RESPONSE
}

enum QuestionSetItemStatus {
  PENDING   // Just generated, awaiting review
  APPROVED  // Reviewer has OK'd it — visible to the picker
  REJECTED  // Reviewer said no — kept for training data, not shown
}

enum Tech {
  TECH_FREE     // Solvable without calculator — exact form, simple arithmetic only
  CAS_ALLOWED   // Could be done by hand but CAS speeds it up — either paper OK
  CAS_REQUIRED  // Needs CAS — decimals, numerical solutions, graphing, statistics
}

enum SubscriptionStatus {
  active
  trialing
  past_due
  canceled
  unpaid
  incomplete
  incomplete_expired
  paused
}

// =====================================================
// Affiliate Program
// =====================================================

enum AffiliateType {
  STUDENT_REFERRAL    // Track A — students earn $5 platform credit
  TUTOR_AFFILIATE     // Track B — tutors earn $10 cash per referral
  INFLUENCER_AFFILIATE // Track C — influencers earn $10 + content fee
}

enum ReferralStatus {
  PENDING                  // Signed up via referral, no paid subscription yet
  PENDING_HOLD             // First paid sub successful, in 30-day hold before commission unlocks
  CONVERTED                // Hold period passed AND referee still subscribed → commission paid
  CHURNED_NO_COMMISSION    // Referee cancelled within 30-day hold → no commission
  EXPIRED                  // Did not convert within window
  REFUNDED                 // Subscription refunded — reward clawed back
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Affiliate {
  id            String        @id @default(cuid())
  userId        String        @unique
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          AffiliateType
  referralCode  String        @unique
  abn           String?       // Required for TUTOR/INFLUENCER
  approved      Boolean       @default(false)
  active        Boolean       @default(true)
  creditBalance Int           @default(0)  // Cents — Track A platform credit
  // Per-affiliate commission override (cents per converted referral). When
  // null, the per-track default is used (lib/affiliate.ts: 500/1000/1000).
  // Used to negotiate higher rates with select influencers.
  commissionOverrideCents Int?
  notes         String?       // Admin notes
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  referrals    Referral[]
  payouts      Payout[]
  contracts    InfluencerContract[]

  @@index([type])
  @@index([approved])
}

model Referral {
  id              String         @id @default(cuid())
  affiliateId     String
  affiliate       Affiliate      @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  referredUserId  String         @unique
  referredUser    User           @relation("ReferredUser", fields: [referredUserId], references: [id], onDelete: Cascade)
  status          ReferralStatus @default(PENDING)
  rewardAmount    Int            @default(0)  // Cents — set on conversion (500 student / 1000 tutor+influencer)
  rewardPaid      Boolean        @default(false)
  createdAt       DateTime       @default(now())
  convertedAt     DateTime?       // First paid subscription (entry to hold period)
  commissionLocksAt DateTime?     // When the 30-day hold expires (nullable — only set during PENDING_HOLD)
  finalizedAt       DateTime?     // Hold passed and commission was issued

  @@index([affiliateId])
  @@index([status])
  @@index([commissionLocksAt])
}

model Payout {
  id          String       @id @default(cuid())
  affiliateId String
  affiliate   Affiliate    @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  amount      Int          // Cents
  type        PayoutType   @default(COMMISSION)
  status      PayoutStatus @default(PENDING)
  method      String?      // e.g. "bank_transfer"
  reference   String?      // External payment reference
  proofUrl    String?      // URL of uploaded transaction screenshot/receipt
  notes       String?
  createdAt   DateTime     @default(now())
  processedAt DateTime?

  @@index([affiliateId])
  @@index([status])
}

enum PayoutType {
  COMMISSION   // Per-referral commission
  CONTENT_FEE  // Influencer upfront content payment
}

// =====================================================
// Operational logs (webhook + audit trail)
// =====================================================

enum WebhookSource {
  STRIPE
}

enum WebhookEventStatus {
  RECEIVED
  SUCCESS
  FAILED
}

/// Log of inbound webhook deliveries. Captured by /api/webhooks/* handlers
/// so admins can see what fired, when, and what went wrong without SSH-ing
/// into the host. Truncated payload snippets help diagnose handler bugs.
model WebhookEvent {
  id          String              @id @default(cuid())
  source      WebhookSource       @default(STRIPE)
  /// Provider's event ID (evt_* for Stripe). Unique so retries are idempotent.
  externalId  String              @unique
  type        String
  status      WebhookEventStatus  @default(RECEIVED)
  error       String?             // Truncated error message when FAILED
  notes       String?             // Optional handler-provided summary
  payload     Json?               // Trimmed payload snippet for debugging
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([createdAt])
  @@index([source, status, createdAt])
}

enum AdminActionType {
  USER_ROLE_CHANGE
  USER_DELETE
  AFFILIATE_APPROVE
  AFFILIATE_DEACTIVATE
  AFFILIATE_CREDIT_ADJUST
  PAYOUT_MARK_PAID
  QUESTION_DELETE
  QUESTION_UPDATE
  EXAM_DELETE
  EXAM_UPDATE
  QUESTION_SET_DEFAULT_SET
  OTHER
}

/// Audit trail for admin mutations. Captured via lib/admin-audit#logAdminAction
/// — every admin-only POST/PATCH/DELETE handler should call it after a
/// successful state change. The actor link survives admin deletion via SetNull.
model AdminActionLog {
  id          String          @id @default(cuid())
  actorId     String?
  actor       User?           @relation("AdminAuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action      AdminActionType
  /// Entity affected — e.g. "User", "Affiliate", "Question". Free-form so new
  /// targets don't require a schema change.
  targetType  String
  /// Stable ID for the affected entity. Null for actions that operate on a
  /// collection rather than a single row.
  targetId    String?
  /// Short human-readable summary ("Promoted alice@example.com to ADMIN").
  summary     String
  /// Structured payload for diffs — before/after values, options, etc.
  metadata    Json?
  createdAt   DateTime        @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([targetType, targetId])
}

// =====================================================
// Teacher assessment builder (T1)
// =====================================================

enum AssessmentStatus {
  DRAFT
  PUBLISHED // Finalized by the teacher; print/export (T2) reads this
  ARCHIVED
}

/// A teacher-authored paper (topic test, SAC-style assessment, homework
/// sheet) assembled from the question bank. T1 scope: items come from the
/// original generated bank (QuestionSetItem, APPROVED) only — past-paper
/// Question linkage exists on AssessmentItem for a future, post-VCAA-
/// permission expansion.
model Assessment {
  id          String           @id @default(cuid())
  teacherId   String
  teacher     User             @relation("TeacherAssessments", fields: [teacherId], references: [id], onDelete: Cascade)
  subjectId   String
  subject     Subject          @relation(fields: [subjectId], references: [id])
  title       String
  description String?
  status      AssessmentStatus @default(DRAFT)
  /// Builder settings snapshot: { topicIds, difficulty: {easy,medium,hard},
  /// tech, targetMarks, questionCount, stylePreset }. Kept as Json so the
  /// builder can evolve without migrations; never read for access control.
  settings    Json?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  items       AssessmentItem[]

  @@index([teacherId, updatedAt])
  @@index([subjectId])
}

/// One question slot in an Assessment. Polymorphic source: exactly one of
/// questionSetItemId (original generated bank — the only source T1 writes)
/// or questionId (VCAA past-paper — reserved, see Assessment doc) is set.
model AssessmentItem {
  id                String           @id @default(cuid())
  assessmentId      String
  assessment        Assessment       @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  /// Display order within the paper (0-based, dense).
  order             Int
  questionSetItemId String?
  questionSetItem   QuestionSetItem? @relation(fields: [questionSetItemId], references: [id], onDelete: Cascade)
  questionId        String?
  question          Question?        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  createdAt         DateTime         @default(now())

  /// DB-level backstop against the same question appearing twice in one
  /// paper — concurrent add-item requests can both pass the route's
  /// read-then-check duplicate guard. (Nullable column: Postgres permits
  /// multiple NULLs, so the reserved questionId path is unaffected.)
  @@unique([assessmentId, questionSetItemId])
  @@index([assessmentId, order])
  @@index([questionSetItemId])
  @@index([questionId])
}

model InfluencerContract {
  id               String    @id @default(cuid())
  affiliateId      String
  affiliate        Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  platform         String    // YouTube, TikTok, Instagram, etc
  platformHandle   String    // @username or channel URL
  followerCount    Int?      // Optional, for admin reference
  contentFee       Int       // Upfront payment in cents
  feePaid          Boolean   @default(false)
  contentUrl       String?   // Link to published video
  contentDeadline  DateTime?
  contentVerified  Boolean   @default(false)
  views            Int?      // View count for the published video — manually entered
  viewsUpdatedAt   DateTime? // When the view count was last updated
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([affiliateId])
}
