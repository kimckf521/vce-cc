# Extractor server for VCE figure extraction.
# Runs the Flask app from scripts/extractor-server.py as a public HTTP service
# that the Vercel-deployed Next.js app can proxy to via EXTRACTOR_API_URL.
#
# Build:   docker build -f scripts/Dockerfile.extractor -t vce-extractor .
# Run:     docker run -p 8080:8080 \
#            -e EXTRACTOR_API_KEY=... \
#            -e SUPABASE_URL=... \
#            -e SUPABASE_SERVICE_KEY=... \
#            vce-extractor

FROM python:3.11-slim

# Tesseract OCR is needed for figure classification (auto kind detection).
RUN apt-get update && apt-get install -y --no-install-recommends \
        tesseract-ocr \
        libgl1-mesa-glx \
        libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python deps first for better layer caching.
COPY scripts/extractor-server-requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

# Copy the extractor source files.
COPY scripts/extractor-server.py /app/extractor-server.py
COPY scripts/figure-extractor.py /app/figure-extractor.py

EXPOSE 8080

# Long timeout because PDF extraction can take 30+ seconds for big files.
CMD ["gunicorn", "-w", "2", "-b", "0.0.0.0:8080", "--timeout", "300", "extractor-server:app"]
